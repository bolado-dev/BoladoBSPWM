# dunstrc — notificaciones monocromas afiladas (a juego con BoladoBSPWM)
# Negro/blanco, sin redondeo, monospace. Rojo solo para urgencia crítica.

[global]
    monitor = 0
    follow = mouse

    # Geometría afilada, esquina superior derecha
    width = 360
    height = 200
    origin = top-right
    offset = 12x40
    scale = 0
    notification_limit = 6

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 360

    indicate_hidden = yes
    transparency = 8
    separator_height = 1
    padding = 10
    horizontal_padding = 12
    text_icon_padding = 8
    frame_width = 1
    frame_color = "#3a3a3a"
    gap_size = 6
    separator_color = frame
    sort = yes

    # Tipografía mono (a juego con kitty/polybar)
    font = Iosevka Nerd Font 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = end
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    # Iconos
    icon_position = left
    min_icon_size = 0
    max_icon_size = 48

    # Redondeo a juego con ventanas/menús (picom corner-radius 14)
    corner_radius = 14

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#0d0d0d"
    foreground = "#8a8a8a"
    frame_color = "#2a2a2a"
    timeout = 4

[urgency_normal]
    background = "#0d0d0d"
    foreground = "#f0f0f0"
    frame_color = "#3a3a3a"
    timeout = 6

[urgency_critical]
    background = "#0d0d0d"
    foreground = "#f0f0f0"
    frame_color = "#e05561"
    timeout = 0
