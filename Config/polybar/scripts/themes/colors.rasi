/* Paleta mínima — mono + 1 acento (violeta).
 * Compartida por launcher/powermenu/powermenu_alt vía @import "colors.rasi" */

* {
    background:        #16161Dff;
    background-alt:    #16161Dff;
    foreground:        #DCD7BAff;
    border:            #957FB8ff;
    selected:          #957FB8ff;
    urgent:            #C34043ff;
    logo:              #957FB8ff;
    on:                #957FB8ff;
    off:               #54546Dff;
}
