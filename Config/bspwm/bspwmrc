#! /bin/sh

wmname LG3D &
# Solo dentro de una VM VMware (en físico no hace nada útil y puede congelar X)
grep -qi 'vmware' /sys/class/dmi/id/sys_vendor 2>/dev/null && vmware-user-suid-wrapper &

pgrep -x sxhkd > /dev/null || sxhkd &

# TECLADO: es+us, Alt+Shift para alternar.
# IBus (activado por im-config vía /etc/X11/Xsession.d/70im-config_launch) sobreescribe
# el layout cuando arranca el primer app GTK. Con use-system-keyboard-layout=true le
# forzamos a seguir el XKB del sistema en vez de gestionar el suyo propio.
gsettings set org.freedesktop.ibus.general use-system-keyboard-layout true 2>/dev/null || true
setxkbmap -layout es,us -model pc105 -option grp:alt_shift_toggle

# Pantallas: aplica el layout guardado con autorandr (se edita con arandr).
# Va ANTES de asignar desktops para que ya existan todos los monitores.
autorandr --change 2>/dev/null

bspc monitor -d I II III IV V VI VII VIII IX X

bspc config border_width         0
bspc config window_gap           6

bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true

bspc rule -a Gimp desktop='VIII' state=floating follow=on
bspc rule -a Chromium desktop='II'
bspc rule -a mplayer2 state=floating
bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off
bspc rule -a float-help state=floating center=on

# RESOLUCION ARANDR


# WALLPAPER
feh --bg-fill ~/Imágenes/wp-senna.png

# POLYBAR
~/.config/polybar/launch.sh

# Reserva para la pill FLOTANTE: offset-y(6) + height(40) = 46. window_gap(6)
# se añade automáticamente debajo → la terminal queda a 6px de la pill, el
# mismo margen que deja a los lados/abajo. Ajustar si cambia offset-y/height.
bspc config top_padding 46

# SERVICIOS (arrancan solo si están instalados)
# greenclip: daemon del historial de portapapeles (Super+V para abrirlo)
if command -v greenclip >/dev/null 2>&1; then
    pgrep -f 'greenclip daemon' >/dev/null || greenclip daemon &
fi
# dunst: notificaciones temadas. Mata el notifyd de xfce (reclama el mismo bus)
# antes de arrancar, para que dunst pueda adueñarse de org.freedesktop.Notifications.
if command -v dunst >/dev/null 2>&1; then
    pkill -x xfce4-notifyd 2>/dev/null
    pkill -x dunst 2>/dev/null
    dunst &
fi

# Sin batería (escritorio): sin ahorro de energía / no apagar pantalla / CPU a tope
if ! ls /sys/class/power_supply/ 2>/dev/null | grep -qiE '^BAT'; then
    xset s off -dpms
    command -v powerprofilesctl >/dev/null && powerprofilesctl set performance 2>/dev/null
fi


# CUSTOM
bspc config focus_follows_pointer true

# NVIDIA: ForceCompositionPipeline necesario para que picom no vaya a 10fps.
# Se aplica DESPUÉS de autorandr para coger el MetaMode real del momento.
if lspci 2>/dev/null | grep -qi 'vga.*nvidia\|nvidia.*vga'; then
    _meta=$(nvidia-settings -q CurrentMetaMode -t 2>/dev/null)
    if [ -n "$_meta" ] && ! echo "$_meta" | grep -q 'ForceCompositionPipeline'; then
        nvidia-settings --assign CurrentMetaMode="$(echo "$_meta" | sed 's/}/,ForceCompositionPipeline=On}/g')" 2>/dev/null || true
    fi
    unset _meta
fi

# PICOM: vsync solo en GPUs no-Intel (en Intel añade input lag; en NVIDIA/AMD
# evita el freeze donde picom se traba y solo el movimiento del ratón lo destrava)
if lspci 2>/dev/null | grep -qi 'vga.*intel\|intel.*vga'; then
    picom &
else
    picom --vsync &
fi
# Sin bordes (look limpio, monocromo)
bspc config border_width 0

xsetroot -cursor_name left_ptr &
