/* ─────────────────────────────────────────────
   Tema rofi monocromo + ámbar (a juego con polybar/kitty/p10k)
   Uso: rofi -show drun -theme ~/.config/rofi-mono.rasi
   ───────────────────────────────────────────── */

configuration {
  show-icons:          true;
  icon-theme:          "Flat-Remix-Slate-Dark";
  drun-display-format: "{icon}  {name}";
  display-drun:        "apps";
  display-run:         "run";
  display-window:      "win";
  modi:                "drun,run,window";
}

* {
  bg:        #0d0d0d;
  bg-alt:    #141414;
  fg:        #f0f0f0;
  fg-muted:  #8a8a8a;
  accent:    #f0f0f0;
  urgent:    #e05561;
  dark:      #0d0d0d;

  background-color: transparent;
  text-color:       @fg;
  font:             "Iosevka Nerd Font 12";
}

window {
  background-color: @bg;
  border:           0;
  border-radius:    0;
  width:            34%;
  padding:          0;
}

mainbox {
  children: [ inputbar, listview ];
  padding:  10px;
  spacing:  8px;
}

inputbar {
  background-color: @bg-alt;
  border-radius:    0;
  padding:          8px 10px;
  spacing:          8px;
  children:         [ prompt, entry ];
}

prompt {
  text-color: @accent;
  str:        ">";
}

entry {
  text-color:        @fg;
  placeholder:       "search…";
  placeholder-color: @fg-muted;
}

listview {
  columns:      1;
  lines:        6;
  fixed-height: false;
  scrollbar:    false;
  spacing:      2px;
}

element {
  padding:       6px 10px;
  border-radius: 0;
  spacing:       10px;
  text-color:    @fg;
}

element normal urgent { text-color: @urgent; }
element normal active  { text-color: @accent; }

element selected {
  background-color: @accent;
  text-color:       @dark;
}
element selected urgent {
  background-color: @urgent;
  text-color:       @dark;
}

element-icon {
  size:           1.2em;
  vertical-align: 0.5;
}

element-text {
  vertical-align: 0.5;
  text-color:     inherit;
}
