#!/usr/bin/env bash
# settarget — gestiona el target activo (HTB/THM) sin tocar /etc/hosts
# El target se guarda en ~/.config/htb_target (formato: "IP HOST")
# Polybar lo muestra via ~/.config/bin/htb_target.sh (interval=2)
set -euo pipefail

TARGET_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/htb_target"

is_ip()    { printf '%s' "$1" | grep -qE '^[0-9]{1,3}(\.[0-9]{1,3}){3}$'; }
norm_host(){ tr '[:upper:]' '[:lower:]' <<<"$1" | tr -s ' '; }

cmd_help() {
    cat <<EOF
Uso:
  settarget <IP> <HOST>   Activa un target (acepta cualquier orden)
  settarget list          Muestra el target actual
  settarget clear         Limpia el target
EOF
}

main() {
    case "${1:-}" in
        help|-h|--help|"")
            cmd_help
            ;;
        list)
            cat "$TARGET_FILE" 2>/dev/null || echo "Sin target activo"
            ;;
        clear)
            rm -f "$TARGET_FILE"
            echo "✔ Target limpiado"
            ;;
        *)
            [[ $# -ge 2 ]] || { echo "Uso: settarget <IP> <HOST>" >&2; exit 1; }
            a="$1"; b="$(norm_host "$2")"
            if   is_ip "$a"; then ip="$a"; host="$b"
            elif is_ip "$b"; then ip="$b"; host="$a"
            else ip="$a"; host="$b"; fi
            mkdir -p "$(dirname "$TARGET_FILE")"
            printf '%s %s\n' "$ip" "$host" > "$TARGET_FILE"
            echo "✔ Target activo: $ip $host"
            ;;
    esac
}

main "$@"
